#!/usr/bin/env python3
"""tint: per-folder and per-event Ghostty window colors.

  tint apply [DIR]        recolor this window for DIR (default: cwd); clears any event tint
  tint reset              recolor this window for the shell's current folder
  tint event NAME         apply the color configured for event NAME (done, needs_you, ...)
  tint hook               Claude Code hook entry point; reads the hook JSON on stdin
  tint windows            list open Ghostty windows with folder and state
  tint apply-all [--force] recolor every open window (skips windows showing an event unless --force)
  tint serve [--port N]   run the local web UI
  tint ui                 open the web UI in the browser (starts the server if needed)
  tint install-hooks      write the Claude Code hooks into ~/.claude/settings.json
  tint config-path        print the config file path

Colors are sent as OSC escape sequences, so only the current window changes.
Every command exits 0: a hook must never break a Claude Code session.
"""

import fnmatch
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
CONFIG_PATH = Path(os.environ.get("TINT_CONFIG", HOME / ".config" / "tint" / "config.json"))
STATE_DIR = Path(os.environ.get("TINT_STATE_DIR", HOME / ".cache" / "tint"))
SETTINGS_PATH = HOME / ".claude" / "settings.json"
UI_DIR = Path(__file__).resolve().parent.parent / "ui"
DEFAULT_PORT = 7337
HEX = re.compile(r"^#[0-9a-fA-F]{6}$")

# Event name -> label, description, default on/off, default color.
# Order is precedence: an event never replaces one listed above it until the
# next turn boundary (Stop) or reset clears the window.
EVENTS = {
    "done": ("Finished", "The turn ended on the /issue sign-off (\"Ready to clear.\").", True, "#0f3d1f"),
    "needs_you": ("Needs you", "A \"Nate Needs To Do This\" callout, a question, a permission prompt, or \"Waiting on Nate.\"", True, "#5c3a00"),
    "stopped": ("Turn ended", "Claude stopped and is waiting for your next message, with nothing special to flag.", False, "#2a2a3a"),
    "idle": ("Idle a while", "Claude has been waiting on you for over a minute.", False, "#3a2a2a"),
}
RANK = {name: i for i, name in enumerate(EVENTS)}

DEFAULT_PALETTE = [
    "#1a1a1a", "#ef4444", "#3cc262", "#f59e0b", "#7aa2e8", "#c084fc", "#4dd0c4", "#d4d4d4",
    "#4a4a4a", "#f87171", "#5fd985", "#fbbf24", "#a8c4f0", "#d8b4fe", "#7ee7dc", "#ffffff",
]

# ANSI colors dark enough to read on a light background (Ghostty's defaults assume a dark one).
LIGHT_PALETTE = [
    "#2a241c", "#b3261e", "#1f7a3f", "#9a6700", "#1d5fb4", "#8a3fb0", "#0f7f8c", "#5c5c5c",
    "#6b6b6b", "#d1403a", "#2e9a55", "#9a6d00", "#2f74d0", "#a35bc9", "#137b86", "#1a1a1a",
]


def theme(name, bg, fg, cursor, light=False):
    return {"name": name, "bg": bg, "fg": fg, "cursor": cursor, "palette": LIGHT_PALETTE if light else [], "light": light}


# Prebuilt starting points for a folder rule. Text clears WCAG AA (4.5:1) on
# every background; test/contrast.py checks that. Order is the gallery order.
THEMES = [
    theme("Forest", "#073a25", "#f5e6b8", "#3cc262"),
    theme("Moss", "#1e2a20", "#dbe5d3", "#8fd18a"),
    theme("Pine", "#0f3d1f", "#e3f0d8", "#5fd985"),
    theme("Teal", "#0f4c4c", "#e0f5f3", "#4dd0c4"),
    theme("Ocean", "#2b5a75", "#f0f6fa", "#ffd166"),
    theme("Midnight", "#1f3a5f", "#e6edf7", "#7aa2e8"),
    theme("Cobalt", "#2e58aa", "#f5f5f5", "#ffd166"),
    theme("Ink", "#0b1021", "#d7dcef", "#7dd3fc"),
    theme("Harbor", "#22303c", "#e6edf3", "#58a6ff"),
    theme("Steel", "#3b4252", "#eceff4", "#88c0d0"),
    theme("Slate", "#2a2a3a", "#e4e4ee", "#c084fc"),
    theme("Graphite", "#1a1a1a", "#e8e8e8", "#e8b04a"),
    theme("Grape", "#3b2a6b", "#ede8fb", "#c4b5fd"),
    theme("Plum", "#4a2040", "#f6e6f3", "#f0a6d8"),
    theme("Rose", "#a0404b", "#fff0f1", "#ffe08a"),
    theme("Brick", "#7a2e2e", "#fde8e8", "#ffd166"),
    theme("Rust", "#6b3a1f", "#fbeadb", "#ffb37a"),
    theme("Espresso", "#3d2410", "#f3e2cf", "#f59e0b"),
    theme("Amber", "#5c3a00", "#fff1d6", "#ffcc66"),
    theme("Olive", "#3a3f1e", "#f0f2dc", "#c7d36f"),
    theme("Paper", "#f6f1e7", "#2a241c", "#b2621a", light=True),
    theme("Mint", "#e6f4ec", "#143d2a", "#1f8f5f", light=True),
    theme("Sky", "#e8f1fa", "#16304a", "#1d6fb8", light=True),
    theme("Blush", "#fbeaec", "#4a1c24", "#c2415a", light=True),
    theme("Lavender", "#eee9f8", "#2d2347", "#6b4fd6", light=True),
]

# Claude Code hook events `tint hook` listens to, and the tool matcher if any.
HOOKS = {
    "Stop": None, "Notification": None, "UserPromptSubmit": None,
    "SessionStart": None, "SessionEnd": None,
    "PreToolUse": "AskUserQuestion", "PostToolUse": "AskUserQuestion",
}
HOOK_COMMAND = '"$HOME/.local/bin/tint" hook'


# ---------------------------------------------------------------- config

def color_or_blank(value):
    value = str(value or "").strip().lower()
    return value if HEX.match(value) else ""


def normalize_folder(f):
    palette = [c for c in (f.get("palette") or []) if HEX.match(str(c))]
    return {
        "name": str(f.get("name") or "").strip(),
        "pattern": str(f.get("pattern") or "").strip(),
        "bg": color_or_blank(f.get("bg")),
        "fg": color_or_blank(f.get("fg")),
        "cursor": color_or_blank(f.get("cursor")),
        "palette": palette if len(palette) == 16 else [],
    }


def normalize_config(data):
    events = {}
    for name, (_, _, enabled, bg) in EVENTS.items():
        ev = data.get("events", {}).get(name) or {}
        events[name] = {
            "enabled": bool(ev.get("enabled", enabled)),
            "bg": color_or_blank(ev.get("bg", bg)),
            "fg": color_or_blank(ev.get("fg")),
        }
    return {
        "version": 1,
        "folders": [normalize_folder(f) for f in data.get("folders") or []],
        "events": events,
    }


def load_config():
    try:
        return normalize_config(json.loads(CONFIG_PATH.read_text()))
    except (OSError, ValueError):
        return normalize_config({})


def save_config(cfg):
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    tmp = CONFIG_PATH.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(cfg, indent=2) + "\n")
    tmp.replace(CONFIG_PATH)


def expand(pattern):
    return os.path.expanduser(pattern.rstrip("/")) if pattern else ""


def match_folder(cfg, cwd):
    """Longest matching pattern wins. A pattern matches the folder itself or anything under it."""
    best = None
    for f in cfg["folders"]:
        pat = expand(f["pattern"])
        if not pat:
            continue
        if fnmatch.fnmatchcase(cwd, pat) or fnmatch.fnmatchcase(cwd, pat + "/*"):
            if best is None or len(pat) > len(expand(best["pattern"])):
                best = f
    return best


# ---------------------------------------------------------------- escape sequences

def osc(code, payload=None):
    return "\033]%s%s\a" % (code, "" if payload is None else ";" + payload)


def seq_defaults():
    """Restore Ghostty's configured foreground, background, cursor, and palette."""
    return osc(110) + osc(111) + osc(112) + osc(104)


def seq_colors(bg="", fg="", cursor="", palette=()):
    """Overlay whichever colors are given, leaving the rest as they are."""
    seq = ""
    if bg:
        seq += osc(11, bg)
    if fg:
        seq += osc(10, fg)
    if cursor:
        seq += osc(12, cursor)
    for i, color in enumerate(palette):
        seq += osc(4, "%d;%s" % (i, color))
    return seq


def seq_folder(folder):
    if not folder:
        return seq_defaults()
    return seq_defaults() + seq_colors(folder["bg"], folder["fg"], folder["cursor"], folder["palette"])


def write_tty(tty, seq):
    if not tty or not seq:
        return
    try:
        fd = os.open(tty, os.O_WRONLY | os.O_NOCTTY)
    except OSError:
        return
    try:
        os.write(fd, seq.encode())
    finally:
        os.close(fd)


# ---------------------------------------------------------------- processes and windows

def ps(args):
    try:
        return subprocess.run(["ps"] + args, capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def process_table():
    rows = {}
    for line in ps(["-axo", "pid=,ppid=,tty=,comm="]).splitlines():
        parts = line.split(None, 3)
        if len(parts) < 4:
            continue
        pid, ppid, tty, comm = int(parts[0]), int(parts[1]), parts[2], parts[3]
        rows[pid] = {"pid": pid, "ppid": ppid, "tty": tty, "comm": comm}
    return rows


def my_tty():
    """The terminal this process belongs to.

    The shell plugin exports TINT_TTY, which Claude and its hooks inherit. Without
    it (hooks have no tty on stdio), walk up to the first ancestor that has one.
    """
    env = os.environ.get("TINT_TTY", "")
    if env.startswith("/dev/"):
        return env
    for fd in (1, 2, 0):
        try:
            return os.ttyname(fd)
        except OSError:
            pass
    rows = process_table()
    pid = os.getpid()
    while pid > 1 and pid in rows:
        if rows[pid]["tty"] != "??":
            return "/dev/" + rows[pid]["tty"]
        pid = rows[pid]["ppid"]
    return None


SHELLS = {"zsh", "bash", "fish", "sh"}


def is_shell(comm):
    return os.path.basename(comm).lstrip("-") in SHELLS


def in_ghostty(pid, rows):
    for _ in range(4):
        row = rows.get(pid)
        if not row:
            return False
        if "ghostty" in row["comm"].lower():
            return True
        pid = row["ppid"]
    return False


def session_shells(rows):
    """tty -> the shell that owns that terminal window (not a subshell)."""
    shells = {}
    for row in rows.values():
        if row["tty"] == "??" or not is_shell(row["comm"]):
            continue
        parent = rows.get(row["ppid"])
        if parent and parent["tty"] == row["tty"] and is_shell(parent["comm"]):
            continue
        shells.setdefault(row["tty"], row)
    return shells


def cwds(pids):
    if not pids:
        return {}
    try:
        out = subprocess.run(
            ["lsof", "-a", "-p", ",".join(str(p) for p in pids), "-d", "cwd", "-Fpn"],
            capture_output=True, text=True, timeout=10,
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return {}
    result, pid = {}, None
    for line in out.splitlines():
        if line.startswith("p"):
            pid = int(line[1:])
        elif line.startswith("n") and pid is not None:
            result[pid] = line[1:]
    return result


def windows(cfg):
    """One entry per Ghostty window: its cwd, matched folder, and event state."""
    rows = process_table()
    shells = {tty: s for tty, s in session_shells(rows).items() if in_ghostty(s["pid"], rows)}
    cwd_by_pid = cwds([s["pid"] for s in shells.values()])
    result = []
    for tty, shell in sorted(shells.items()):
        cwd = cwd_by_pid.get(shell["pid"], "")
        folder = match_folder(cfg, cwd) if cwd else None
        result.append({
            "tty": "/dev/" + tty,
            "cwd": cwd,
            "folder": folder["pattern"] if folder else "",
            "name": (folder and folder["name"]) or (os.path.basename(cwd) if cwd else tty),
            "event": read_state(tty).get("event", ""),
        })
    return result


def shell_cwd(tty):
    shell = session_shells(process_table()).get(tty.replace("/dev/", ""))
    return cwds([shell["pid"]]).get(shell["pid"], "") if shell else ""


# ---------------------------------------------------------------- state

def state_path(tty):
    return STATE_DIR / (tty.replace("/dev/", "") + ".json")


def read_state(tty):
    try:
        return json.loads(state_path(tty).read_text())
    except (OSError, ValueError):
        return {}


def write_state(tty, event):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    state_path(tty).write_text(json.dumps({"event": event, "at": int(time.time())}))


def clear_state(tty):
    try:
        state_path(tty).unlink()
    except OSError:
        pass


# ---------------------------------------------------------------- actions

def apply_folder(tty, cwd, cfg):
    write_tty(tty, seq_folder(match_folder(cfg, cwd)))
    clear_state(tty)


def reset_window(tty, cfg, fallback_cwd=""):
    apply_folder(tty, shell_cwd(tty) or fallback_cwd or os.getcwd(), cfg)


def apply_event(tty, name, cfg):
    """Tint the window for an event unless it is disabled or outranked by the event already showing."""
    ev = cfg["events"].get(name)
    current = read_state(tty).get("event")
    if not ev or not ev["enabled"] or not ev["bg"]:
        return
    if current in RANK and RANK[current] < RANK[name]:
        return
    write_tty(tty, seq_colors(ev["bg"], ev["fg"]))
    write_state(tty, name)


def apply_all(cfg, wins, force=False):
    applied = []
    for w in wins:
        if w["cwd"] and (force or not w["event"]):
            apply_folder(w["tty"], w["cwd"], cfg)
            w["event"] = ""
            applied.append(w["tty"])
    return applied


# ---------------------------------------------------------------- Claude Code hook

def text_blocks(msg):
    content = (msg.get("message") or {}).get("content")
    if isinstance(content, str):
        yield content
    elif isinstance(content, list):
        for block in content:
            if isinstance(block, dict) and block.get("type") == "text":
                yield block.get("text") or ""


def last_assistant_text(path):
    try:
        with open(path, "rb") as fh:
            fh.seek(0, 2)
            fh.seek(max(0, fh.tell() - (1 << 20)))
            lines = fh.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return ""
    for line in reversed(lines):
        try:
            msg = json.loads(line)
        except ValueError:
            continue
        if msg.get("type") == "assistant" and not msg.get("isSidechain"):
            text = "\n".join(text_blocks(msg))
            if text:
                return text
    return ""


def classify_stop(data):
    text = data.get("last_assistant_message") or last_assistant_text(data.get("transcript_path") or "")
    lines = [l for l in text.splitlines() if l.strip(" `")]
    last = lines[-1] if lines else ""
    if "Ready to clear." in last:
        return "done"
    if "NATE NEEDS TO DO THIS" in text or "Waiting on Nate." in last:
        return "needs_you"
    return "stopped"


def cmd_hook():
    try:
        data = json.load(sys.stdin)
    except ValueError:
        return
    tty = my_tty()
    if not tty:
        return
    cfg = load_config()
    name = data.get("hook_event_name", "")
    cwd = data.get("cwd", "")

    def reset_if_tinted():
        if state_path(tty).exists():
            reset_window(tty, cfg, cwd)

    if name == "Stop":
        reset_if_tinted()
        apply_event(tty, classify_stop(data), cfg)
    elif name == "Notification":
        kind = data.get("notification_type", "")
        if kind in ("permission_prompt", "elicitation_dialog"):
            apply_event(tty, "needs_you", cfg)
        elif kind == "idle_prompt":
            apply_event(tty, "idle", cfg)
    elif name == "PreToolUse":
        if data.get("tool_name") == "AskUserQuestion":
            apply_event(tty, "needs_you", cfg)
    else:  # PostToolUse, UserPromptSubmit, SessionStart, SessionEnd
        reset_if_tinted()


def install_hooks():
    """Replace every tint hook entry in ~/.claude/settings.json with the current HOOKS table."""
    try:
        settings = json.loads(SETTINGS_PATH.read_text())
    except (OSError, ValueError):
        settings = {}
    hooks = settings.setdefault("hooks", {})
    for event in list(hooks):
        hooks[event] = [e for e in hooks[event] if not any("tint" in (h.get("command") or "") for h in e.get("hooks", []))]
    for event, matcher in HOOKS.items():
        entry = {"hooks": [{"type": "command", "command": HOOK_COMMAND, "timeout": 10}]}
        if matcher:
            entry["matcher"] = matcher
        hooks.setdefault(event, []).append(entry)
    settings["hooks"] = {k: v for k, v in hooks.items() if v}
    SETTINGS_PATH.write_text(json.dumps(settings, indent=2) + "\n")


# ---------------------------------------------------------------- web UI

_dirs_cache = {}


def code_dirs():
    """Subfolders of ~/code and ~/worktrees for the folder pattern picker, cached per directory mtime."""
    dirs = []
    for base in (HOME / "code", HOME / "worktrees"):
        try:
            mtime = base.stat().st_mtime
        except OSError:
            continue
        if _dirs_cache.get(base, (None,))[0] != mtime:
            names = ["~/" + str(e.relative_to(HOME)) for e in sorted(base.iterdir()) if e.is_dir() and not e.name.startswith(".")]
            _dirs_cache[base] = (mtime, names)
        dirs.extend(_dirs_cache[base][1])
    return dirs


def serve(port):
    import http.server
    import socketserver
    from urllib.parse import urlparse

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *args):
            pass

        def send_bytes(self, body, ctype, status=200):
            self.send_response(status)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def send_json(self, obj, status=200):
            self.send_bytes(json.dumps(obj).encode(), "application/json", status)

        def not_found(self):
            self.send_json({"error": "not found"}, 404)

        def read_json(self):
            length = int(self.headers.get("Content-Length") or 0)
            try:
                return json.loads(self.rfile.read(length) or b"{}")
            except ValueError:
                return {}

        def state(self, cfg, wins):
            return {
                "config": cfg,
                "config_path": str(CONFIG_PATH),
                "windows": wins,
                "events": [{"name": n, "label": l, "description": d} for n, (l, d, _, _) in EVENTS.items()],
                "default_palette": DEFAULT_PALETTE,
                "themes": THEMES,
                "dirs": code_dirs(),
            }

        def do_GET(self):
            path = urlparse(self.path).path
            if path == "/api/state":
                cfg = load_config()
                return self.send_json(self.state(cfg, windows(cfg)))
            if path in ("/", "/index.html"):
                try:
                    return self.send_bytes((UI_DIR / "index.html").read_bytes(), "text/html; charset=utf-8")
                except OSError:
                    return self.send_json({"error": "ui/index.html missing"}, 500)
            self.not_found()

        def do_PUT(self):
            if urlparse(self.path).path != "/api/config":
                return self.not_found()
            cfg = normalize_config(self.read_json())
            save_config(cfg)
            wins = windows(cfg)
            apply_all(cfg, wins)
            self.send_json(self.state(cfg, wins))

        def do_POST(self):
            path = urlparse(self.path).path
            data = self.read_json()
            tty = data.get("tty") or ""
            if tty and not re.match(r"^/dev/ttys\d+$", tty):
                return self.send_json({"error": "bad tty"}, 400)
            cfg = load_config()
            if path == "/api/apply":
                if tty:
                    reset_window(tty, cfg)
                    applied = [tty]
                    wins = windows(cfg)
                else:
                    wins = windows(cfg)
                    applied = apply_all(cfg, wins, force=bool(data.get("force")))
                return self.send_json({"applied": applied, "windows": wins})
            if path == "/api/preview" and tty:
                colors = normalize_folder(data)
                seq = seq_colors(colors["bg"], colors["fg"], colors["cursor"], colors["palette"])
                write_tty(tty, (seq_defaults() if data.get("reset") else "") + seq)
                return self.send_json({"ok": True})
            self.not_found()

    class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
        allow_reuse_address = True
        daemon_threads = True

    with Server(("127.0.0.1", port), Handler) as httpd:
        print("tint ui on http://127.0.0.1:%d" % port, flush=True)
        httpd.serve_forever()


def server_running(port):
    import socket
    with socket.socket() as s:
        s.settimeout(0.3)
        return s.connect_ex(("127.0.0.1", port)) == 0


def cmd_ui(port):
    if not server_running(port):
        subprocess.Popen([sys.executable, __file__, "serve", "--port", str(port)],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        for _ in range(30):
            if server_running(port):
                break
            time.sleep(0.1)
    subprocess.run(["open", "http://127.0.0.1:%d" % port])


# ---------------------------------------------------------------- main

def port_arg(args):
    if "--port" in args:
        return int(args[args.index("--port") + 1])
    return int(os.environ.get("TINT_PORT", DEFAULT_PORT))


def main(argv):
    cmd = argv[0] if argv else "apply"
    args = argv[1:]
    if cmd in ("apply", "reset", "event"):
        tty = my_tty()
        if not tty:
            return
        cfg = load_config()
        if cmd == "apply":
            apply_folder(tty, os.path.abspath(args[0]) if args else os.getcwd(), cfg)
        elif cmd == "reset":
            reset_window(tty, cfg)
        elif args:
            apply_event(tty, args[0], cfg)
    elif cmd == "hook":
        cmd_hook()
    elif cmd == "windows":
        for w in windows(load_config()):
            print("%-9s %-10s %-12s %s" % (w["tty"].replace("/dev/", ""), w["event"] or "-", w["name"][:12], w["cwd"]))
    elif cmd == "apply-all":
        cfg = load_config()
        print("\n".join(apply_all(cfg, windows(cfg), force="--force" in args)))
    elif cmd == "serve":
        serve(port_arg(args))
    elif cmd == "ui":
        cmd_ui(port_arg(args))
    elif cmd == "install-hooks":
        install_hooks()
    elif cmd == "config-path":
        print(CONFIG_PATH)
    else:
        print(__doc__)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except KeyboardInterrupt:
        pass
    except Exception as exc:  # a hook must never break a session
        if sys.argv[1:2] not in (["hook"], ["apply"]):
            print("tint: %s" % exc, file=sys.stderr)
    sys.exit(0)
